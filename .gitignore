# Dependencies (restored by `mise run setup` from aube-lock.yaml)
node_modules/

# Wrangler build output and local state
dist/
.wrangler/

# Vendored from the htmx repo by `mise run setup` — not source
.github/skills/

# Generated by `mise run setup`: symlinks to .github/skills/*.md so Claude Code
# can discover them. Never edit or commit.
.claude/skills/

# Secrets. Never commit these; use `wrangler secret put` for deployed values.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Machine-local Claude Code state (permissions etc). Shared config belongs in
# .claude/settings.json, which IS committed.
.claude/settings.local.json

# Local tool state. mise reads both spellings of the local override.
.mise.local.toml
mise.local.toml
*.log

# Editors
.vscode/
.idea/

# macOS
.DS_Store
